*.dump
*.sql.gz
backup_*/

# ---- Node / frontend tooling ----
node_modules/

# ---- Test & QA artifacts (screenshots for README live in docs/screenshots/) ----
screenshots/
test-results/
playwright-report/
.pw-cache/

# ---- OS / editor ----
.DS_Store
*.swp
.idea/
