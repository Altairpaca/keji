# ---- Tooling / agent state (never commit) ----
.omo/
.opencode/
.codegraph/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# ---- Django runtime ----
db.sqlite3
media/
staticfiles/
static_collected/
*.log
collectstatic/

