# 客迹 Keji — 生产环境变量模板（复制为 .env.production 后填写，.env.production 不入库）。
# 复制：cp docker/prod/.env.production.example .env.production
# 启动：docker compose --env-file .env.production -f docker/prod/compose.yaml up -d --build
#
# 此文件不含任何真实密钥。所有占位值必须在使用前替换。

# ---- Django -------------------------------------------------------------
# 必填：生产启动强制要求。生成命令：
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# 允许的 Host（逗号分隔）。走 nginx 反代访问时建议显式列出域名/内网 IP。
ALLOWED_HOSTS=localhost,127.0.0.1

# admin 入口前缀（避免默认 /admin/ 被扫描）
ADMIN_URL=admin

# 生产默认强制 Secure Cookie（HTTPS 下必须保持 true）。
# 若仅供纯 HTTP 内网调试临时设为 false，公网/HTTPS 部署务必 true。
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# ---- 数据库 --------------------------------------------------------------
# 必填：DB 口令（强随机，禁止 keji/keji）。与下方 POSTGRES_PASSWORD 保持一致。
DB_NAME=keji
DB_USER=keji
DB_PASSWORD=

# 供 db 容器初始化的同源口令（compose ${POSTGRES_PASSWORD:?} 强制检查）。
POSTGRES_PASSWORD=
POSTGRES_DB=keji
POSTGRES_USER=keji

# ---- 媒体与备份 ----------------------------------------------------------
# 媒体根目录（镜像内路径，由 prod-media 卷承载，一般无需修改）。
MEDIA_ROOT=/app/media

# 备份保留份数（backup 命令）
BACKUP_RETENTION_COUNT=7

# ---- Gunicorn（可选覆盖） ------------------------------------------------
WORKERS=3
