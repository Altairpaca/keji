# ===========================================================================
# 客迹 Keji — 环境变量模板
#
# 用法：cp .env.example .env，然后按需修改。
# .env 已被 .gitignore 排除，永不提交。
# 本文件只含占位符，绝不放真实密钥 / 密码。
# ===========================================================================

# ---------------------------------------------------------------------------
# Django 安全密钥
# ---------------------------------------------------------------------------
# 用于会话签名 / CSRF / 密码哈希等。生产必须修改为强随机值，例如：
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# 生产必须修改：是
SECRET_KEY=change-me

# 调试模式。生产必须为 false（开启 DEBUG 会泄露源码、配置与密钥）。
DEBUG=true

# 允许访问的主机名，逗号分隔。生产必须改为你的域名，如 keji.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# 数据库连接（仅本地开发）
# ---------------------------------------------------------------------------
# 以下默认值匹配 docker/dev/compose.yaml 的本地开发容器。
# 仅本地开发使用：是。生产环境请改用强口令并限制访问来源。
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=keji
DB_USER=keji
DB_PASSWORD=keji

# ---------------------------------------------------------------------------
# 存储与备份
# ---------------------------------------------------------------------------
# 用户上传文件的根目录（照片原图 / 缩略图 / 回收站）。生产必须指向持久化磁盘。
MEDIA_ROOT=/app/media

# 备份输出目录（数据库 dump 与文件清单）。生产必须指向持久化磁盘。
# 备份在 web 容器内执行（manage.py backup）：/app/backups 对应宿主仓库 backups/ 目录。
# 注意：容器以 root 运行，备份产物属主为 root，宿主侧查看需 sudo 或执行 chown。
BACKUP_DIR=/app/backups

# 保留的备份份数，超出后自动清理最旧备份（manage.py backup 每次运行后按此清理）。
BACKUP_RETENTION_COUNT=30

# ---------------------------------------------------------------------------
# 安全 Cookie
# ---------------------------------------------------------------------------
# 启用后会话 / CSRF Cookie 仅通过 HTTPS 传输。
# 生产必须修改：仅 HTTPS 部署时两者均设为 true。
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# 后台管理入口
# ---------------------------------------------------------------------------
# Django admin 的 URL 前缀。生产必须改为非常规路径，降低被扫描风险。
# 例：ADMIN_URL=admin-x7k9z2 → 后台位于 https://你的域名/admin-x7k9z2/
ADMIN_URL=admin

# ---------------------------------------------------------------------------
# 登录限流
# ---------------------------------------------------------------------------
# 登录尝试限流，格式：次数/时间窗（django-axes 风格）。
# 例：5/15m 表示每 15 分钟最多 5 次。生产建议保留。
LOGIN_RATE_LIMIT=5/15m
